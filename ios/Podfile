# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.6'
prepare_react_native_project!

$RNFirebaseAsStaticFramework = true
use_frameworks! :linkage => :static

target 'meditation_blossom' do
  pod 'Firebase/Core'
  pod 'Firebase/Analytics'
  pod 'Firebase/Messaging'
  pod 'Firebase/InAppMessaging'
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'meditation_blossomTests' do
    inherit! :complete
    # Pods for testing
  end

 # 위젯 타겟 설정 (search paths와 필요한 추가적인 네이티브 라이브러리만 상속/포함)
  target 'MeditationBlossomWidgetExtension' do
    inherit! :search_paths # 이 명령어만으로 충분해야 합니다.
    # 필요한 경우에만 위젯에서 사용하는 RN 라이브러리(e.g., react-native-firebase) Pods를 추가합니다.
  end

  # 푸시 서비스 타겟 설정
  target 'PushNotificationService' do
    inherit! :search_paths
    # ...
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ENABLE_BITCODE'] = 'NO'
        # static linkage 시 ObjC 카테고리 누락 방지
        config.build_settings['OTHER_LDFLAGS'] ||= ['$(inherited)']
        unless config.build_settings['OTHER_LDFLAGS'].include?('-ObjC')
          config.build_settings['OTHER_LDFLAGS'] << '-ObjC'
        end
      end

      # RN 0.78.1이 고정한 fmt 11.0.2가 Xcode 26.4+(Apple clang 21)의 강화된 consteval
      # 상수식 검사를 통과하지 못해 format-inl.h에서 컴파일 에러 발생.
      # (facebook/react-native#55601, fmtlib/fmt#4740). 공식 수정은 fmt 12.1.0에 있고
      # RN 0.85.0+ 부터 번들됨 — 그 버전으로 업그레이드하면 이 블록은 제거 가능.
      # 그 전까지는 fmt pod만 C++17로 컴파일해 consteval 경로 자체를 회피.
      if target.name == 'fmt'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end
