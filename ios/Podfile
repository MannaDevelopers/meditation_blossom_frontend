# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.6'
prepare_react_native_project!

$RNFirebaseAsStaticFramework = true
use_frameworks! :linkage => :static

target 'meditation_blossom' do
  pod 'Firebase/Core'
  pod 'Firebase/Analytics'
  pod 'Firebase/Messaging'
  pod 'Firebase/InAppMessaging'
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # RN 0.84+의 "prebuilt RNCore" 배포 시스템이 react-native-firebase의 정적 링킹과 충돌해
  # iOS 빌드가 깨짐 (invertase/react-native-firebase#8883). RNFB 계열 pod만 static library로
  # 강제해서 회피 - 메인테이너가 권장하는 bare RN CLI용 워크어라운드.
  pre_install do |installer|
    installer.pod_targets.each do |pod|
      if pod.name.start_with?('RNFB')
        def pod.build_type
          Pod::BuildType.static_library
        end
      end
    end
  end

  target 'meditation_blossomTests' do
    inherit! :complete
    # Pods for testing
  end

 # 위젯 타겟 설정 (search paths와 필요한 추가적인 네이티브 라이브러리만 상속/포함)
  target 'MeditationBlossomWidgetExtension' do
    inherit! :search_paths # 이 명령어만으로 충분해야 합니다.
    # 필요한 경우에만 위젯에서 사용하는 RN 라이브러리(e.g., react-native-firebase) Pods를 추가합니다.
  end

  # 푸시 서비스 타겟 설정
  target 'PushNotificationService' do
    inherit! :search_paths
    # ...
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ENABLE_BITCODE'] = 'NO'
        # static linkage 시 ObjC 카테고리 누락 방지
        config.build_settings['OTHER_LDFLAGS'] ||= ['$(inherited)']
        unless config.build_settings['OTHER_LDFLAGS'].include?('-ObjC')
          config.build_settings['OTHER_LDFLAGS'] << '-ObjC'
        end
      end
    end
  end
end
